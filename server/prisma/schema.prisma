generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id             Int       @id @default(autoincrement())
  activeLlmId    String?
  activeLlm      LlmModel? @relation(fields: [activeLlmId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LlmModel {
  id            String     @id @default(uuid())
  name          String     @unique
  size          String
  type          String     @default("LLM")
  description   String
  fileSize      String
  quantization  String
  contextWindow String
  isActive      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  settings      Settings[]
}

model ChatSession {
  id        String        @id @default(uuid())
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  reasoning String?
  createdAt DateTime     @default(now())
}

model FunctionSchema {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  parameters  String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
